[Unit]
Description=ZipfGuard independent computation party
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zipfguard
WorkingDirectory=/var/lib/zipfguard-own-party
ExecStart=/opt/zipfguard/.venv/bin/python /opt/zipfguard/privacy/service/node.py -C mpc.ini -I 0 -T 1 -K 40 --ssl --node-config /var/lib/zipfguard-own-party/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zipfguard-own-party

[Install]
WantedBy=multi-user.target
