{
  "manifest_version": 3,
  "name": "TriGuard 用户口令助手",
  "version": "1.0.0",
  "key": "",
  "description": "在独立扩展中私密注册、登录与修改口令。网站不接收口令明文。",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://localhost:8541/*",
    "https://localhost:8542/*",
    "https://localhost:8543/*",
    "https://localhost:8531/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}